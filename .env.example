# Porta do servidor Express
PORT=3001

# Segredo para assinar tokens de sessão
PDV_SECRET=troque-por-um-segredo-forte

# Opção 1: String de conexão completa (ex.: PostgreSQL local, Neon, Supabase, Render, Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sorveteria_pdv

# Opção 2: Variáveis individuais (usadas caso DATABASE_URL não seja informada)
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=sorveteria_pdv
# PGSSL=false
